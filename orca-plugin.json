{
  "manifestVersion": 2,
  "id": "rego-syntax",
  "name": "Rego Syntax",
  "version": "1.0.2",
  "execution": "data",
  "description": "Syntax highlighting for Open Policy Agent Rego (.rego) files.",
  "license": "Apache-2.0",
  "repository": "https://github.com/royklo/orca-rego",
  "engines": {
    "orca": ">=1.4.246"
  },
  "contributes": {
    "syntaxes": [
      {
        "id": "rego",
        "title": "Rego",
        "scopeName": "source.rego",
        "path": "syntaxes/rego.tmLanguage.json",
        "configuration": "syntaxes/language-configuration.json",
        "extensions": [
          ".rego"
        ]
      }
    ]
  },
  "capabilities": [],
  "cover": {
    "path": "images/cover.png",
    "alt": "A Rego authorization policy in the Orca editor with keywords, strings, comments and built-in calls in their own colours"
  }
}
